{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/lint-gate.sh --fast",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/hooks/lint-gate.sh --full",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
