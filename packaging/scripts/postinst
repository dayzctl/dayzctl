#!/bin/sh
# The package ships no systemd units: `dayzctl apply` renders dayz-web.service
# and the instance/update/prune units from the configuration and enables them,
# so there is nothing to refresh here.
set -e

# Map data is read from /usr/share/dayzctl/maps; make sure it is readable.
if [ -d /usr/share/dayzctl/maps ]; then
        chmod -R a+rX /usr/share/dayzctl/maps || true
fi

exit 0
