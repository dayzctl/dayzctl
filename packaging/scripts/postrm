#!/bin/sh
# On remove (not upgrade) leave /etc/dayzctl/config.yaml in place: it holds the
# operator's settings. Units generated by `dayzctl apply` stay in
# /etc/systemd/system until they are removed by hand.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
        if [ -d /run/systemd/system ]; then
                systemctl daemon-reload >/dev/null 2>&1 || true
        fi
fi

exit 0
