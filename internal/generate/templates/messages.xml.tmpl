<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<messages>
{{- range .Messages }}
    <message>
        <delay>{{.Delay}}</delay>
        <repeat>{{.Repeat}}</repeat>
        <deadline>{{.Deadline}}</deadline>
        <onconnect>{{.OnConnect}}</onconnect>
        <shutdown>{{.Shutdown}}</shutdown>
        <text>{{.Text}}</text>
    </message>
{{- end }}
</messages>
