<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by dayzctl from the 'messages' block.
     DayZ reads this file from the mission folder at server start.
     All time values are in minutes. -->
<messages>
{{- with .Welcome }}
    <message>
        {{- if gt .Delay 0 }}
        <delay>{{.Delay}}</delay>
        {{- end }}
        <onconnect>1</onconnect>
        <text>{{.Text}}</text>
    </message>
{{- end }}
{{- range .Cyclic }}
    <message>
        {{- if gt .Delay 0 }}
        <delay>{{.Delay}}</delay>
        {{- end }}
        <repeat>{{.Every}}</repeat>
        {{- if .OnConnect }}
        <onconnect>1</onconnect>
        {{- end }}
        <text>{{.Text}}</text>
    </message>
{{- end }}
{{- with .Shutdown }}
    <message>
        <deadline>{{.Deadline}}</deadline>
        {{- if .Stop }}
        <shutdown>1</shutdown>
        {{- end }}
        <text>{{.Text}}</text>
    </message>
{{- end }}
</messages>
