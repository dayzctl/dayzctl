<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by dayzctl from the 'messages' block.
     DayZ reads this file from the mission folder at server start.
     All time values are in minutes. -->
<messages>
{{- range .Messages }}
    <message>
        <delay>{{.Delay}}</delay>
        <repeat>{{.Repeat}}</repeat>
        <deadline>{{.Deadline}}</deadline>
        <onconnect>{{.OnConnect}}</onconnect>
        <shutdown>{{.Shutdown}}</shutdown>
        <text>{{.Text}}</text>
    </message>
{{- end }}
</messages>
