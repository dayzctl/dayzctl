[Unit]
Description=dayzctl web UI and log analysis API
Documentation=https://github.com/dayzctl/dayzctl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The listen address and port come from web.address / web.port in the config
# file, so changing them does not require regenerating this unit.
ExecStart={{ .BinaryPath }} web
{{ if .WorkingDir }}WorkingDirectory={{ .WorkingDir }}
{{ end }}Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# The service only reads the config and the instances' profiles folders.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/etc/dayzctl

[Install]
WantedBy=multi-user.target
