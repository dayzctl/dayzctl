[Unit]
Description=dayzctl web UI and log analysis API
Documentation=https://github.com/dayzctl/dayzctl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The listen address and port come from web.address / web.port in the config
# file, so changing them does not require regenerating this unit.
ExecStart={{ .BinaryPath }} web
{{ if .WorkingDir }}WorkingDirectory={{ .WorkingDir }}
{{ end }}Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# The web UI reads logs and, when an admin is granted from the Players tab,
# rewrites only the web.auth.steam.admins block in the config file. Everything
# else stays read-only; this path needs to be writable for that one edit.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/etc/dayzctl

[Install]
WantedBy=multi-user.target
