## DayZ Server Configuration Template

steam:
  username: "%%STEAM_USER%%"

paths:
  base: "/srv/dayz"

# Server instances
instances:
  - name: dayz
    instanceId: 1
    port: 2302
    steam_query_port: 27016
    template: dayzOffline.chernarusplus
    hostname: "DayZ Server"
    max_players: 60
    enabled: true
    rcon:
      enabled: true
      port: 2306
      password: rcon123
    mods: []
    servermods: []
    # Optional: scheduled restart warnings + graceful shutdown, written to
    # this instance's mission db/messages.xml. 'deadline' is expressed in
    # minutes after server start. The generator converts minutes to seconds
    # when writing db/messages.xml that DayZ reads. The message with
    # 'shutdown: true' tells the DayZ server to save and exit cleanly once
    # its deadline is reached (see 'dayzctl help apply').
    shutdown_messages:
      # 6h - 5 minutes => 355 minutes
      - deadline: 355  # 6h - 5 min
        text: "Server restart in 5 minutes"
      # 6h => 360 minutes
      - deadline: 360  # 6h
        text: "Server is restarting now!"
        shutdown: true

# Backup settings
backup:
  enabled: true
  retention_days: 14
  keep_daily: 7
  keep_weekly: 4

# Update settings
updates:
  enabled: true
  schedule: "04:00"

# Healthcheck settings
healthcheck:
  enabled: true
  startup_timeout: 300

# Server-wide settings
server:
  max_players: 60
  battleye: 1
