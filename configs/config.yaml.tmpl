## DayZ Server Configuration Template

steam:
  username: "%%STEAM_USER%%"

paths:
  base: "/srv/dayz"

# Server instances
instances:
  - name: dayz
    instanceId: 1
    port: 2302
    steam_query_port: 27016
    template: dayzOffline.chernarusplus
    hostname: "DayZ Server"
    max_players: 60
    enabled: true
    rcon:
      enabled: true
      port: 2306
      password: rcon123
    mods: []
    servermods: []
    # Optional: background image for the log analyzer's Map tab. Relative paths
    # are resolved against paths.install_dir; absolute paths and http(s) URLs
    # work too. When unset, dayzctl looks for map.jpg / map.png / <name>.png in
    # the instance's profiles folder, then <install_dir>/maps, then install_dir.
    # map_image: "maps/chernarus.jpg"
    # map_image: "https://example.com/nasdara-map.jpg"
    #
    # Community map used for satellite tiles and place names in the Map tab.
    # Defaults to the instance name, so an instance called "nasdara" needs no
    # setting. Only maps bundled with the binary are available; generate more
    # with: go run ./tools/mapfetch -map chernarusplus -zooms 3,4
    # map: nasdara

# Scheduled restart warnings + graceful shutdown (DayZ "Server Messages").
#
# DayZ reads messages.xml from the MISSION folder, not per instance, so this
# block is defined once here and written to the mission of every map in use:
#   <installDir>/mpmissions/<template>/db/messages.xml
# Instances sharing a template share the file; each distinct map gets a copy.
# Every value is in minutes, relative to server start. A message with
# 'deadline' is a countdown: DayZ announces it at 90, 60, 45, 30, 20, 15, 10,
# 5, 2 and 1 minutes before the deadline, and 'shutdown: true' makes the server
# save and exit when it is reached (ignored without 'deadline'). Placeholders:
# #name (server name), #port (server port), #tmin (minutes remaining).
shutdown_messages:
  # 6h - 5 minutes => 355 minutes
  - deadline: 355  # 6h - 5 min
    text: "Server restart in 5 minutes"
  # 6h => 360 minutes
  - deadline: 360  # 6h
    text: "Server is restarting now!"
    shutdown: true

# Backup settings
backup:
  enabled: true
  retention_days: 14
  keep_daily: 7
  keep_weekly: 4

# Update settings
updates:
  enabled: true
  schedule: "04:00"

# Healthcheck settings
healthcheck:
  enabled: true
  startup_timeout: 300

# Server-wide settings
server:
  max_players: 60
  battleye: 1
  # Admin log flags, written to serverDZ.cfg as adminLogPlacement and
  # adminLogBuildActions. Both default to 1 (enabled) when unset.
  # admin_log_placement: 1     # log item/base placement
  # admin_log_build_actions: 1 # log build actions

# Web UI and log analysis API (ADM/RPT).
# `dayzctl apply` owns the service: it writes and enables dayz-web.service when
# enabled is true, removes and disables it when false, and only reloads
# systemd when a unit file actually changed.
# There is no built-in authentication: keep the loopback address, or put an
# authenticating reverse proxy in front of it before binding to 0.0.0.0.
web:
  enabled: true
  address: 127.0.0.1
  port: 8081
  # Login switch. Enabled false leaves the UI open, which is only safe on
  # loopback. Use a password_hash (sha256 of the password, e.g.
  # `printf %s 'secret' | sha256sum`) instead of a plain password when the
  # config file can be read by anyone else.
  auth:
    enabled: false
    username: "admin"
    # password: "change-me"
    # password_hash: "<64 hex characters>"
    # session_hours: 12
